root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yaml,yml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_new_line_before_open_brace = all
csharp_prefer_braces = true:suggestion

[*.ps1]
# Windows PowerShell 5.1 распознаёт кириллицу в исходнике по BOM.
charset = utf-8-bom
